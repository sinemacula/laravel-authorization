{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src"
        ],
        // Scoped gate: only the evaluation hot path and the manager are mutated here.
        // Everything else (contracts, enums, exceptions, facades, service provider,
        // models, traits of boilerplate shape) is covered by `infection.full.json5`
        // on the scheduled job.
        excludes: [
            "AuthorizationServiceProvider.php",
            "Contracts",
            "Database",
            "Enums",
            "Exceptions",
            "Facades",
            "Models",
            "Resolvers"
        ]
    },
    logs: {
        summary: "build/infection-summary.log",
        text: "build/infection.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    timeout: 15,
    mutators: {
        "@default": true
    }
}
