<?xml version="1.0"?>
<ruleset name="Project">

    <!-- DisallowMixedTypeHint excluded: the package evaluates arbitrary
         consumer-authored policy documents, so condition operands, contexts,
         and attribute values are user-shaped by design and mixed is the
         honest type. PHPStan still guards unsafe mixed access. -->
    <rule ref="SineMaculaLaravelPackage">
        <exclude name="SlevomatCodingStandard.TypeHints.DisallowMixedTypeHint"/>
    </rule>

    <file>src</file>
    <file>benchmarks</file>
    <file>database</file>
    <file>tests</file>

</ruleset>
